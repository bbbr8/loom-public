# Qubit games: each one is a question. `solve` searches every classical strategy and lets an AI search
# measurement strategies on shared entangled qubits, then proves the value exactly.
seed 7

game chsh "Can two players who cannot talk beat 3/4 by sharing qubits?" {
  players alice(x -> a), bob(y -> b)
  win (a + b) % 2 == x * y
}
solve chsh
expect classical(chsh) == 3/4
expect quantum(chsh) == 1/2 + sqrt(2)/4            # Tsirelson's bound, reached exactly

game mermin "Can three players win Mermin's parity game every time?" {
  players p1(x -> a), p2(y -> b), p3(z -> c)
  promise xor(x, y, z) == 0
  win (xor(a, b, c) == 1) == (x == 1 or y == 1 or z == 1)
}
solve mermin
expect classical(mermin) == 3/4
expect quantum(mermin) == 1                       # certainty: no classical strategy can do this

game telepathy "Can entanglement carry a message — can Alice learn Bob's bit?" {
  players alice(x -> a), bob(y -> b)
  win a == y
}
solve telepathy
expect quantum(telepathy) == classical(telepathy)   # no: entanglement alone never signals

game copycat "Does a trivial game gain anything from qubits?" {
  players alice(x -> a), bob(y -> b)
  win a == x and b == y
}
solve copycat
expect quantum(copycat) == 1

game cycle "Can qubits help in the odd-cycle game (inputs 0..2)?" {
  players alice(x: 3 -> a), bob(y: 3 -> b)
  promise y == x or y == (x + 1) % 3
  win (a == b) == (x == y)
}
solve cycle
expect classical(cycle) == 5/6
expect quantum(cycle) > classical(cycle)          # the true optimum cos²(π/12) sits off the dyadic grid
