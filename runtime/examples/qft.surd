# Quantum Fourier transform on 3 wires — every phase is a multiple of π/4, so it stays exact.
gate qft3: a, b, c {
  a <- h
  (b, a) <- cp(pi/2)
  (c, a) <- cp(pi/4)
  b <- h
  (c, b) <- cp(pi/2)
  c <- h
  (a, c) <- swap
}
wires q: 3
q[0] <- x
q[2] <- x                              # |101>
q <- qft3
for i in 0..8 {
  expect prob(q, i) == 1/8             # flat magnitudes, information in the phases
}
q <- ~qft3
expect prob(q, "101") == 1
expect qft3 >> ~qft3 == id & id & id  # the same fact, as an exact identity of whole unitaries
